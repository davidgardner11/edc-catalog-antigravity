<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 700" width="600" height="700">
      <defs>
        <linearGradient id="bg-evergoods-cpl24-5" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#18181b"/>
          <stop offset="100%" stop-color="#09090b"/>
        </linearGradient>
        <linearGradient id="packGrad-evergoods-cpl24-5" x1="0%" y1="0%" x2="50%" y2="100%">
          <stop offset="0%" stop-color="#0284c7"/>
          <stop offset="100%" stop-color="#09090b"/>
        </linearGradient>
        <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
          <feDropShadow dx="0" dy="16" stdDeviation="24" flood-opacity="0.35"/>
        </filter>
        <pattern id="grid-evergoods-cpl24-5" width="30" height="30" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="30" y2="0" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
          <line x1="0" y1="0" x2="0" y2="30" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
        </pattern>
      </defs>

      <!-- Background Canvas -->
      <rect width="600" height="700" fill="url(#bg-evergoods-cpl24-5)"/>
      <rect width="600" height="700" fill="url(#grid-evergoods-cpl24-5)"/>

      <!-- Ambient Glow -->
      <circle cx="300" cy="380" r="220" fill="#0284c7" opacity="0.15" filter="blur(50px)"/>

      <!-- Backpack Silhouette Illustration -->
      <g filter="url(#shadow)" transform="translate(300, 360)">
        <!-- Main Body -->
        <rect x="-130" y="-170" width="260" height="320" rx="42" fill="url(#packGrad-evergoods-cpl24-5)" stroke="#0f172a" stroke-width="3" opacity="0.95"/>
        
        <!-- Top Carry Handle -->
        <path d="M -50 -170 Q 0 -210 50 -170" fill="none" stroke="#0f172a" stroke-width="14" stroke-linecap="round"/>
        
        <!-- Front Compression / Zip Panels -->
        <path d="M -110 -100 L 110 -100" stroke="rgba(255,255,255,0.2)" stroke-width="4" stroke-dasharray="6,4"/>
        <rect x="-100" y="-70" width="200" height="90" rx="16" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.15)" stroke-width="2"/>
        
        <!-- Lower Quick-Access Pocket -->
        <rect x="-100" y="40" width="200" height="85" rx="14" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.1)" stroke-width="2"/>
        
        <!-- Zipper Pulls & Molle Straps -->
        <rect x="-80" y="-50" width="160" height="6" rx="3" fill="#0f172a" opacity="0.8"/>
        <rect x="-80" y="-30" width="160" height="6" rx="3" fill="#0f172a" opacity="0.8"/>
        
        <!-- Brand Patch / Logo Box -->
        <rect x="-35" y="70" width="70" height="26" rx="6" fill="#111827" stroke="#0f172a" stroke-width="1.5"/>
        <text x="0" y="87" font-family="-apple-system, system-ui, sans-serif" font-size="10" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="1.5">EVERGOODS</text>

        <!-- Dynamic Slide Indicator Badge -->
        <rect x="-85" y="165" width="170" height="26" rx="13" fill="rgba(255,255,255,0.12)" stroke="rgba(255,255,255,0.2)" stroke-width="1"/>
        <text x="0" y="182" font-family="-apple-system, system-ui, sans-serif" font-size="11" font-weight="600" fill="#ffffff" text-anchor="middle">
          IMAGE 5 OF 5 • DETAIL CLOSE-UP
        </text>
      </g>

      <!-- Watermark Capacity -->
      <text x="560" y="660" font-family="-apple-system, system-ui, sans-serif" font-size="28" font-weight="900" fill="#ffffff" opacity="0.12" text-anchor="end">24L</text>
    </svg>